# Build config for the OPPO Watch 2 (OW20W3) custom build.
#
# The watch is a 32-bit armv7l device (msm8937, kernel 4.9.193-perf+,
# aarch32), so only armeabi-v7a is needed. Restricting abiList keeps the
# APK at roughly half the size of the stock all-ABI build and shortens
# the native compile step.
abiList=armeabi-v7a

# Version string shown in the app.
#
# Without this the build falls back to the git HEAD short hash, which is what
# made the manager report a mismatch and offer "repair environment" against a
# stock install. A readable version avoids that entirely.
version=31.0-watch

# Keep the upstream version code so the manager still compares equal to the
# v31 daemon it ships with.
versionCode=31000
